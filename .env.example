# ===== LLM：微信 OpenAI 兼容接口（仅用于生成回答） =====
LLM_BASE_URL=https://chatapi.weixin.qq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=Deepseek-v4-flash

# ===== ES：docker 里已在运行的 es8-ik:8.15.0 =====
# 注意用 127.0.0.1 而非 localhost：Windows 系统代理开启时，requests 对
# localhost 主机名不走本地绕过、会被代理转一圈（实测每请求固定慢 ~21s），
# 127.0.0.1 则正常绕过（~40ms）
ES_URL=http://127.0.0.1:9200
# 若 ES 开了安全认证，取消注释并填入（执行时会自动探测）
# ES_USER=elastic
# ES_PASSWORD=changeme

# ===== TEI：docker compose 启动的向量/重排服务 =====
TEI_EMBED_URL=http://127.0.0.1:8081
TEI_RERANK_URL=http://127.0.0.1:8082

# ===== 其他 =====
INDEX_NAME=rag_lab_demo
# HTTP host 白名单（防SSRF）：代码里所有出站请求只允许这些 host
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,chatapi.weixin.qq.com

# ===== langfuse（自托管 v2，docker-compose.langfuse.yml）=====
LANGFUSE_PUBLIC_KEY=pk-lf-raglab000000000000000000000000000
LANGFUSE_SECRET_KEY=sk-lf-raglab000000000000000000000000000
LANGFUSE_HOST=http://127.0.0.1:3000
